# Garmin RepTrace configuration. Copy to .env; never commit the filled-in file.
USER_TIMEZONE=UTC
GARMINCONNECT_IS_CN=False

# Get a dedicated bot token from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=
# Optional: positive numeric Telegram user ID. Leave blank to pair securely.
TELEGRAM_ALLOWED_USER_ID=
# Optional: private one-time pairing secret. If blank, one is generated in bot logs.
TELEGRAM_PAIRING_CODE=
WEB_ALLOWED_HOSTS=
# Dashboard defaults to localhost so changing Wi-Fi/VPN addresses cannot stop it.
WEB_BIND_IP=127.0.0.1

# Telegram reports (Monday's report covers the previous Monday–Sunday).
REPORT_TIMEZONE=UTC
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_TIME=09:00
POST_WORKOUT_REPORT_ENABLED=true
# Wait for a new synced session's data to remain stable for this many seconds.
REPORT_SETTLE_SECONDS=300
# OpenAI writes post-workout commentary; Monday summaries are calculated locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol

# gpt-6-luna is also supported.
OPENAI_REASONING_EFFORT=medium

# Private tool-enabled Telegram chat (normal messages or /ask).
OPENAI_CHAT_MODEL=gpt-6-sol
OPENAI_CHAT_REASONING_EFFORT=low
OPENAI_FOOD_MODEL=gpt-6-sol
# Your hand length, for scale when your whole hand appears in a food photo.
FOOD_HAND_LENGTH_CM=
# Monthly HTML review on the first day at WEEKLY_REPORT_TIME in REPORT_TIMEZONE.
MONTHLY_REPORT_ENABLED=true
